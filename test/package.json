{
  "name": "bedrock-vue-vc-test",
  "version": "0.0.1-0",
  "type": "module",
  "private": true,
  "description": "Vue.js credential card component for Bedrock Web apps test",
  "browser": {
    ".": "./components/index.js"
  },
  "scripts": {
    "start": "node --preserve-symlinks test.js",
    "test": "node --preserve-symlinks test.js test --framework karma",
    "test:debug": "node --preserve-symlinks test.js test --framework karma --log-level debug",
    "coverage": "node --preserve-symlinks test.js test --framework karma-coverage",
    "coverage-ci": "node --preserve-symlinks test.js test --framework karma-coverage-ci"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalbazaar/bedrock-vue-vc"
  },
  "keywords": [
    "bedrock"
  ],
  "author": {
    "name": "Digital Bazaar, Inc.",
    "email": "support@digitalbazaar.com",
    "url": "https://digitalbazaar.com"
  },
  "bugs": {
    "url": "https://github.com/digitalbazaar/bedrock-vue-vc/issues"
  },
  "homepage": "https://github.com/digitalbazaar/bedrock-vue-vc",
  "dependencies": {
    "@bedrock/core": "^6.3.0",
    "@bedrock/express": "^8.8.0",
    "@bedrock/karma": "^8.0.0",
    "@bedrock/quasar": "^10.0.1",
    "@bedrock/server": "^5.2.0",
    "@bedrock/test": "^10.0.0",
    "@bedrock/views": "^12.0.0",
    "@bedrock/vue": "^5.2.1",
    "@bedrock/vue-vc": "file:..",
    "@bedrock/web": "^3.1.0",
    "@bedrock/web-fontawesome": "^2.1.0",
    "@bedrock/webpack": "^11.7.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  }
}
